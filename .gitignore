# ============================================================
# rl-vla-journey / .gitignore
# 原则：产物不进版本库，源码才进
# ============================================================

# ---------- 训练产物（本仓库最大的一类） ----------
# 注意写法：必须用 outputs/* 而不是 outputs/
# 因为 git 不会进入被完全排除的目录，那样 !outputs/.gitkeep 这条否定规则就失效了
outputs/*
!outputs/.gitkeep

# ---------- Python 运行时 ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# ---------- 虚拟环境 ----------
.venv/
venv/
env/
ENV/

# ---------- Jupyter ----------
.ipynb_checkpoints/
*.ipynb_checkpoints/

# 模型权重与数据（体积大，且可重新生成/下载）
# ⚠️ 这里的 / 不能省：
#     data/      → 匹配**任意层级**的 data 目录，包括 src/data/ ← 会吞掉源码！
#     /data/     → 只匹配项目根目录下的 data/
# 这个坑很隐蔽：文件不会报错，只是怎么 add 都加不进去
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.h5
*.pkl
*.npz
*.npy
/data/
/datasets/

# ---------- 实验追踪工具的本地缓存 ----------
wandb/
runs/
lightning_logs/
*.tfevents.*
events.out.tfevents.*

# ---------- 日志 ----------
*.log

# ---------- 编辑器与系统 ----------
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini
.Trash-*

# ---------- 环境变量与密钥（永远不要提交） ----------
.env
.env.*
*.key
*.pem
secrets.yaml

# ---------- 临时文件 ----------
*.tmp
.tmp-*/
*.bak
*.orig
*.rej

# ---------- 本地练习 / 草稿（学完就删，不进版本库） ----------
# 这些是学习过程中的试验代码，不是项目的一部分。
# 需要保留某个的话，就把它改成正式文件名（去掉 play_ 前缀）。
scripts/play_*.py
scripts/_probe*.py
# 根目录下的临时练手脚本（PyCharm 里右键新建的默认名常是 1.py / 2.py）
/1.py
/2.py
/3.py
/play_*.py
/_probe*.py
